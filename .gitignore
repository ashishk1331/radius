# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv

# Personal files — your bookmark exports, never the project's own config
*.json
*.jsonl
*.db
!vercel.json
!public/.well-known/*.json

# Local configuration — .env.example is the committed template
.env
.env.*
!.env.example

# Token signing key material. Never commit these; the published JWKS is
# regenerated from them by `radius keys init`.
keys/

# Copy to .env.local (default) or .env.production, then select with RADIUS_ENV.
# Real environment variables always override these files.

# --- Auth -------------------------------------------------------------------
# The issuer and audience are matched exactly against the `iss` and `aud`
# claims of incoming tokens. Change them and previously issued tokens stop
# verifying — which is the point.
JWT_ISSUER=http://127.0.0.1:9000
JWT_AUDIENCE=radius-mcp
JWT_TOKEN_TTL=3600

# Leave JWKS_URI unset to verify against the local public key file, which is
# what you want when one process both signs and serves. Set it only when the
# verifier must fetch keys over HTTP from a separate issuer.
# JWKS_URI=https://your-mcp-server.vercel.app/.well-known/jwks.json

# --- Paths (relative paths resolve against the project root) ----------------
# RADIUS_HOME=/path/to/radius
# RADIUS_DB_PATH=bookmarks.db
# RADIUS_PRIVATE_KEY=keys/private.pem
# RADIUS_PUBLIC_KEY=keys/public.pem
# RADIUS_JWKS_PATH=public/.well-known/jwks.json

# --- Server -----------------------------------------------------------------
RADIUS_HOST=127.0.0.1
RADIUS_PORT=9000

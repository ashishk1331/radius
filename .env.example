# radius configuration
#
#   cp .env.example .env.local        and you are ready to run locally
#
# Files load in order: .env.<RADIUS_ENV> then .env. RADIUS_ENV defaults to
# "local". Real environment variables override both.
#
# Everything below is optional except where marked. Commented lines show the
# default.


# ── Server ───────────────────────────────────────────────────────────────────

RADIUS_HOST=127.0.0.1
RADIUS_PORT=9000


# ── Auth ─────────────────────────────────────────────────────────────────────
# Issuer and audience are matched exactly against a token's `iss` and `aud`.
# Changing either invalidates every token already issued — which is one way to
# cut off access.

JWT_ISSUER=http://127.0.0.1:9000
JWT_AUDIENCE=radius-mcp
JWT_TOKEN_TTL=3600

# The verification key. By default it is read from keys/public.pem. Set this
# instead on hosts that deploy from git and never receive the file — Vercel,
# for one. Public material; the private key stays on your machine.
# RADIUS_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Fetch verification keys over HTTP instead of reading them locally. Only for
# when a separate process issues the tokens.
# JWKS_URI=https://your-app.vercel.app/.well-known/jwks.json


# ── Turso ────────────────────────────────────────────────────────────────────
# The corpus. Set these and radius reads and writes the hosted database
# directly — the same one locally and in production, with no second copy to
# keep in step. The token needs write access for ingestion.
#
#   turso db show radius --url        → TURSO_DATABASE_URL
#   turso db tokens create radius     → TURSO_AUTH_TOKEN
#
# Leave unset to fall back to a plain local libSQL file at RADIUS_DB_PATH,
# which is there for tests and offline work.

# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=


# ── Paths ────────────────────────────────────────────────────────────────────
# Relative paths resolve against the project root.

# RADIUS_HOME=/path/to/radius
# RADIUS_DB_PATH=bookmarks.db
# RADIUS_PRIVATE_KEY=keys/private.pem
# RADIUS_PUBLIC_KEY=keys/public.pem
# RADIUS_JWKS_PATH=public/.well-known/jwks.json
